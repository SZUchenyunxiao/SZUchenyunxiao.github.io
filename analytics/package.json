{
  "name": "portfolio-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers + D1 访问统计服务与管理后台",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply portfolio-analytics --remote",
    "db:migrate:local": "wrangler d1 migrations apply portfolio-analytics --local",
    "password:hash": "node ./scripts/hash-password.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "typescript": "^5.5.0",
    "wrangler": "^4.132.0"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
